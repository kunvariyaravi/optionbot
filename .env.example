# Copy to .env and fill in. Nothing here places real orders.
# NSE public client needs no key. Kite keys come in Phase 4.
ENV=development
PORT=8000

# Risk defaults (override per run via CLI flags too)
MAX_DAILY_LOSS=5000
MAX_POSITION_QTY=200
KILL_SWITCH=false

# Phase 4 (leave blank for now)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
